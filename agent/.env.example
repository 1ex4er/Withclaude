# Скопируй в agent/.env и заполни. Этот файл никогда не коммитится.

# Пароль RCon — тот же, что RConPassword в battleye/beserver_x64.cfg.
# Используется только локально, на сайт не передаётся.
RCON_PASSWORD=

# Логин Steam для SteamCMD (обновление модов). Пароль не нужен:
# один раз войди вручную "steamcmd +login <логин>" с кодом Steam Guard — сессия сохранится.
STEAM_USER=
