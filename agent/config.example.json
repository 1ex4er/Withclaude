{
  "hubs": [
    {
      "name": "blackout",
      "url": "wss://blackoutstalkerrp.ru/agent-ws",
      "agentId": "blackout-main",
      "sitePublicKey": "keys/site_public.pem",
      "allow": ["*"]
    },
    {
      "name": "lx",
      "url": "wss://lxmodschngz.ru/agent-ws",
      "license": "LX-XXXX-XXXX-XXXX",
      "allow": ["agent.info", "server.status", "lx.*"]
    }
  ],

  "server": {
    "dir": "C:\\DayZServer",
    "exe": "DayZServer_x64.exe",
    "config": "serverDZ.cfg",
    "port": 2302,
    "profiles": "profiles",
    "bePath": "battleye",
    "extraArgs": ["-dologs", "-adminlog", "-netlog", "-freezecheck"],
    "mods": ["@CF"],
    "serverMods": [],
    "autoRestartOnCrash": true,
    "stopTimeoutSec": 60
  },

  "schedule": {
    "restarts": ["00:00", "04:00", "08:00", "12:00", "16:00", "20:00"],
    "warnMinutes": [15, 5, 1],
    "warnMessage": "Рестарт сервера через {min} мин."
  },

  "rcon": {
    "allowRaw": false
  },

  "files": {
    "roots": {
      "server": "C:\\DayZServer",
      "mission": "C:\\DayZServer\\mpmissions\\dayzOffline.chernarusplus",
      "profiles": "C:\\DayZServer\\profiles"
    },
    "maxSizeMb": 10,
    "keepBackups": 50
  },

  "lx": {
    "modPrefix": "@LX",
    "roots": {
      "lx": "C:\\DayZServer\\profiles\\LX"
    }
  },

  "steamcmd": {
    "path": "C:\\steamcmd\\steamcmd.exe"
  }
}
