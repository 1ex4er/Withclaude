# Скопируй в bot/.env. Этот файл никогда не коммитится.

# Токен бота: Discord Developer Portal -> Applications -> Bot -> Reset Token
DISCORD_TOKEN=

# Ключ Steam Web API для проверки банов: https://steamcommunity.com/dev/apikey
STEAM_API_KEY=

# Токен для админки сайта (вызовы /api/...). Длинная случайная строка, например:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
API_TOKEN=

# Токены внешних баз банов (если у них есть API), имена задаются в banCheck.providers[].tokenEnv
# HUNTEREYE_TOKEN=

# Прокси до Discord, если на сервере Discord заблокирован (например, zapret/tpws в режиме SOCKS):
# DISCORD_PROXY=socks5://127.0.0.1:1080
